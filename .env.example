# Xen Orchestra Packer Plugin - Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then load it before building:
#   source .env
#   packer build example/debian13-uefi.pkr.hcl

# Required Configuration
export PKR_VAR_rest_endpoint="http://192.168.1.10"
export PKR_VAR_token="your-authentication-token-here"
export PKR_VAR_username="packer"
export PKR_VAR_password="PasswordduTurfu!"
export PKR_VAR_pool_name="default"
export PKR_VAR_sr_name="Local storage"
export PKR_VAR_sr_iso_name="ISOs"
export PKR_VAR_iso_name="debian-13.5.0-amd64-netinst.iso"

# Optional: Custom VM names (leave empty to use auto-generated names with timestamp)
# export PKR_VAR_vm_name="template-debian13-uefi"
# export PKR_VAR_vm_description="Debian 13 UEFI Golden Image"
